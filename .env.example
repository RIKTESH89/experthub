# Database (Neon or local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/experthub?schema=public"
# Direct connection URL (for Neon — skip connection pooler for migrations)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/experthub?schema=public"

# NextAuth
AUTH_SECRET="generate-a-random-secret-min-32-chars"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-min-32-chars"

# OpenAI (for Digital Twin AI responses)
OPENAI_API_KEY="sk-..."

# Web Search (Tavily - for Digital Twin internet augmentation)
TAVILY_API_KEY=""

# Email (Resend - for password reset, notifications)
RESEND_API_KEY="re_..."
EMAIL_FROM="ExpertHub <noreply@yourdomain.com>"

# AWS S3 (for file uploads - images, videos, audio)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="experthub-uploads"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
