      "synthetic": true
    },
    {
      "id": "ada-style-2025",
      "expert": "ada",
      "split": "train",
      "date": "2025-04-01",
      "audience": "public",
      "text": "Start small. State the tradeoff. Keep the next step reversible.",
      "chunkIds": [
        "ada-style-2025:chunk_0"
      ],
      "inputType": "text/post",
      "synthetic": true
    },
    {
      "id": "ben-style-2025",
      "expert": "ben",
      "split": "train",
      "date": "2025-04-01",
      "audience": "public",
      "text": "I weigh independent releases against operating complexity, then propose a bounded experiment.",
      "chunkIds": [
        "ben-style-2025:chunk_0"
      ],
      "inputType": "text/post",
      "synthetic": true
    },
    {
      "id": "ada-public-2026-confirmation",
      "expert": "ada",
      "split": "heldout",
      "date": "2026-08-02",
      "audience": "public",
      "text": "For a small team, I prefer a monolith to reduce operational work. I reconsider when independent deployment is required.",
      "chunkIds": [
        "ada-public-2026-confirmation:chunk_0"
      ],
      "inputType": "text/post",
      "synthetic": true
    },
    {
      "id": "ben-public-2026-reason",
      "expert": "ben",
      "split": "heldout",
      "date": "2026-08-02",
      "audience": "public",
      "text": "For a large team, I prefer independently deployable services because teams can release separately. I start with a small experiment before a migration.",
      "chunkIds": [
        "ben-public-2026-reason:chunk_0"
      ],
      "inputType": "text/post",
      "synthetic": true
    },
    {
      "id": "ada-public-2026-rare-tool",
      "expert": "ada",
      "split": "heldout",
      "date": "2026-08-03",
      "audience": "public",
      "text": "For rare-tool, I recommend a reversible trial before making it a standard.",
      "chunkIds": [
        "ada-public-2026-rare-tool:chunk_0"
      ],
      "inputType": "text/post",
      "synthetic": true
    },
